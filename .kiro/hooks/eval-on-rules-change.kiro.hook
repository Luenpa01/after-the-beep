{
  "enabled": false,
  "name": "Run evaluation on rule or prompt changes",
  "description": "Runs the evaluation set when risk-engine rules or prompts change and reports detection and false-positive rates.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["packages/risk-engine/src/rules/**/*.ts", "prompts/**/*.md"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run `npm run eval`. Report the percentage of scams detected and of legitimate calls blocked. If detection drops below 90% or false positives exceed 5%, list the failing scripts and propose the minimal weight or rule change, without applying it."
  }
}
