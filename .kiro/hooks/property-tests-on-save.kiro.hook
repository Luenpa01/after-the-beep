{
  "enabled": false,
  "name": "Risk engine property tests",
  "description": "Runs the property tests whenever a risk-engine file is saved.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["packages/risk-engine/src/**/*.ts"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run `npm test -w packages/risk-engine`. If a property fails, show fast-check's minimal counterexample and explain which requirement in requirements.md it breaks."
  }
}
