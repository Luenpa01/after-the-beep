{
  "enabled": false,
  "name": "Safe word leak guard",
  "description": "Checks that no change writes the safe word to logs, transcripts, prompts, or alerts.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["apps/**/*.ts", "apps/**/*.tsx", "prompts/**/*.md"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review the edited file. If any safe-word variable (safeWord, safeWordPlain, or similar) reaches a logger, a persisted transcript, a prompt, or an alert, point to the exact line and propose a fix, per requirement 9.1."
  }
}
